import pandas as pd
import matplotlib.pyplot as plt

# The 'Year' column already exists and contains the publication year.
# We will use this directly, assuming it's in a suitable format or can be converted.
# If your 'Publication Year' column has a different name, please adjust 'Year' accordingly.
df['Year'] = pd.to_numeric(df['Year'], errors='coerce')

# Drop rows where 'Year' could not be converted to a number (e.g., NaN from 'coerce')
df.dropna(subset=['Year'], inplace=True);
df['Year'] = df['Year'].astype(int)

# Annual counts
annual_counts = df.groupby('Year').size()

# Plot
plt.figure(figsize=(12,7)) # Increased figure size for better readability of labels
ax = annual_counts.plot(kind='bar', color='skyblue', edgecolor='black')
plt.plot(annual_counts.index, annual_counts.values, color='orange', marker='o', linewidth=2)

# Add exact values on top of each bar
for container in ax.containers:
    ax.bar_label(container, fmt='%d', label_type='edge', padding=3)

plt.title("Annual Publication Trend")
plt.xlabel("Year")
plt.ylabel("Number of Publications")
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.xticks(rotation=45, ha='right') # Rotate x-axis labels for better readability
plt.tight_layout() # Adjust layout to prevent labels from being cut off
plt.show()
